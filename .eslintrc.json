{
  "extends": "./node_modules/gts/",
  "rules": {
    "node/no-unsupported-features/es-builtins": ["error", { "version": ">=20.0.0" }],
    "node/no-unsupported-features/node-builtins": ["error", { "version": ">=20.0.0" }],
    "no-process-exit": "off",
    "@typescript-eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }]
  },
  "overrides": [
    {
      "files": ["test/**/*.ts"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off"
      }
    }
  ]
}
