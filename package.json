{
  "name": "fireblocks-nst",
  "version": "1.0.0",
  "description": "Non-Standard Token Integration in Fireblocks Service",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "files": [
    "build/src"
  ],
  "scripts": {
    "test": "mocha --recursive --ignore 'build/test/integration/**' build/test/",
    "test:integration": "tsc && node build/test/integration/strk.integration.js",
    "cli:sweep": "tsc && node build/src/cli/sweep.js",
    "cli:deploy": "tsc && node build/src/cli/deploy.js",
    "cli:deploy-pool": "tsc && node build/src/cli/deploy-pool.js",
    "cli:sweep-pool": "tsc && node build/src/cli/sweep-pool.js",
    "lint": "gts lint",
    "clean": "gts clean",
    "compile": "tsc",
    "fix": "gts fix",
    "prepare": "npm run compile",
    "pretest": "npm run compile",
    "posttest": "npm run lint"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "dotenv": "^17.2.3",
    "starknet": "^9.4.2"
  },
  "devDependencies": {
    "@types/mocha": "^9.1.1",
    "@types/node": "^14.11.2",
    "@types/node-fetch": "^2.6.2",
    "@types/sinon": "^21.0.0",
    "gts": "^3.1.1",
    "mocha": "^11.7.5",
    "sinon": "^21.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EjaraApp/fireblocks-nst.git"
  },
  "keywords": [
    "fireblocks",
    "crypto"
  ],
  "author": "Jay",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/EjaraApp/fireblocks-nst/issues"
  },
  "homepage": "https://github.com/EjaraApp/fireblocks-nst#readme",
  "overrides": {
    "serialize-javascript": "^7.0.3",
    "diff": "^8.0.3"
  }
}
